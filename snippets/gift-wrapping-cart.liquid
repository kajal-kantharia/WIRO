{%- if item.properties['_Gift wrapping id'] != blank -%}
  {%- assign gift_wrap_price = blank -%}
  {%- assign gift_wrap_active = 'No' -%}
  {%- if item.properties['Gift wrapping'] == 'Yes' -%}
    {%- assign gift_wrap_active = 'Yes' -%}
  {%- endif -%}
  {%- assign gift_wrap_variant = item.properties['_Gift wrapping id'] | split: '--' | first -%}
  {%- assign gift_wrap_id_parts = item.properties['_Gift wrapping id'] | split: '--' -%}
  {%- assign gift_wrap_inventory_token = gift_wrap_id_parts[1] -%}
  {%- assign gift_wrap_remaining = blank -%}
  {%- assign gift_wrap_quantity_in_cart = 0 -%}
  {%- if item.properties['_Gift wrapping variant'] != blank -%}
    {%- assign gift_wrap_variant = item.properties['_Gift wrapping variant'] -%}
  {%- endif -%}
  {%- assign gift_wrap_variant_id = gift_wrap_variant | plus: 0 -%}
  {%- for linked_item in cart.items -%}
    {%- if linked_item.properties['_Gift wrapping for'] == item.properties['_Gift wrapping id'] -%}
      {%- assign gift_wrap_price = linked_item.final_price | money -%}
    {%- endif -%}
    {%- if linked_item.properties['_Gift wrapping for'] != blank and linked_item.variant.id == gift_wrap_variant_id -%}
      {%- assign gift_wrap_quantity_in_cart = gift_wrap_quantity_in_cart | plus: linked_item.quantity -%}
    {%- endif -%}
  {%- endfor -%}
  {%- unless gift_wrap_variant == 'free' or gift_wrap_inventory_token contains 'gift' or gift_wrap_inventory_token == blank -%}
    {%- assign gift_wrap_remaining = gift_wrap_inventory_token | minus: gift_wrap_quantity_in_cart -%}
  {%- endunless -%}
  <div class="gift-wrapping-cart tw-mt-[10px] tw-w-full tw-bg-[#f5f5f5] tw-p-[12px] tw-text-[#1f1f1f]" data-gift-wrapping-cart data-gift-id="{{ item.properties['_Gift wrapping id'] }}" data-gift-wrap-active="{{ gift_wrap_active }}" data-gift-wrap-variant="{{ gift_wrap_variant }}" data-gift-wrap-price="{{ item.properties['_Gift wrapping price'] }}">
    <div class="tw-flex tw-items-center tw-justify-between tw-gap-[7px]">
      <label class="tw-flex tw-items-center tw-gap-[8px] tw-text-[14px] tw-font-medium tw-leading-[20px]">
        <input class="tw-m-0 tw-h-[15px] tw-w-[15px] tw-flex-none tw-accent-[#1f1f1f] disabled:tw-cursor-not-allowed disabled:tw-opacity-50" type="checkbox" {% if gift_wrap_active == 'Yes' %}checked{% endif %} {% if gift_wrap_active != 'Yes' and gift_wrap_remaining != blank and gift_wrap_remaining <= 0 %}disabled{% endif %} data-gift-cart-toggle>
        <span>Wrap as a gift? {% if gift_wrap_variant == 'free' %}(Free){% elsif gift_wrap_price != blank %}(+{{ gift_wrap_price }}){% elsif item.properties['_Gift wrapping price'] != blank %}(+{{ item.properties['_Gift wrapping price'] }}){% endif %}</span>
      </label>
      <button class="button button--tertiary tw-flex tw-min-h-0 tw-items-center tw-justify-end tw-gap-[3px] tw-p-0 tw-text-[13px] tw-font-normal tw-leading-[20px]" type="button" data-gift-edit {% if gift_wrap_active != 'Yes' %}hidden{% endif %}>
        <span>Edit</span>
        <img class="tw-h-[16px] tw-w-[16px]" src="{{ 'icon-gift-edit.svg' | asset_url }}" alt="" width="20" height="20">
      </button>
      <button class="button button--tertiary tw-flex tw-min-h-0 tw-items-center tw-justify-end tw-gap-[3px] tw-p-0 tw-text-[13px] tw-font-normal tw-leading-[20px]" type="button" data-gift-cancel hidden>
        <span>Cancel</span>
        <img class="tw-h-[16px] tw-w-[16px]" src="{{ 'icon-gift-cancel.svg' | asset_url }}" alt="" width="16" height="16">
      </button>
    </div>
    <p class="tw-mb-0 tw-mt-[6px] tw-text-[12px] tw-leading-[18px] tw-text-[#777]" data-gift-summary {% if gift_wrap_active != 'Yes' %}hidden{% endif %}>To: {{ item.properties['To'] }} / From: {{ item.properties['From'] }} / “{{ item.properties['Gift message'] }}”</p>
    <div class="tw-mt-[16px] tw-grid tw-gap-[16px]" data-gift-edit-form hidden>
      <label class="tw-grid tw-gap-[10px] tw-text-[16px] tw-font-medium tw-leading-[20px]">
        <span>To <span class="tw-text-[red]">*</span></span>
        <input class="tw-h-[44px] tw-w-full tw-rounded-[4px] tw-border tw-border-solid tw-border-[#c9c9c9] tw-bg-white tw-px-[16px] tw-py-[10px] tw-font-[inherit] tw-text-[16px] tw-font-normal tw-leading-[24px] tw-text-[#1f1f1f]" name="To" value="{{ item.properties['To'] | escape }}" required>
      </label>
      <label class="tw-grid tw-gap-[10px] tw-text-[16px] tw-font-medium tw-leading-[20px]">
        <span>From <span class="tw-text-[red]">*</span></span>
        <input class="tw-h-[44px] tw-w-full tw-rounded-[4px] tw-border tw-border-solid tw-border-[#c9c9c9] tw-bg-white tw-px-[16px] tw-py-[10px] tw-font-[inherit] tw-text-[16px] tw-font-normal tw-leading-[24px] tw-text-[#1f1f1f]" name="From" value="{{ item.properties['From'] | escape }}" required>
      </label>
      <label class="tw-grid tw-gap-[10px] tw-text-[16px] tw-font-medium tw-leading-[20px]">
        <span>Gift message <span class="tw-text-[red]">*</span></span>
        <textarea class="tw-min-h-[142px] tw-w-full tw-resize-y tw-rounded-[4px] tw-border tw-border-solid tw-border-[#c9c9c9] tw-bg-white tw-px-[16px] tw-py-[12px] tw-font-[inherit] tw-text-[16px] tw-font-normal tw-leading-[24px] tw-text-[#1f1f1f]" name="Gift message" required>{{ item.properties['Gift message'] | escape }}</textarea>
      </label>
      <button class="button tw-h-[43px] tw-min-h-0 tw-w-full tw-rounded-[3px] tw-bg-[#1f1f1f] tw-p-0 tw-text-[16px] tw-font-normal tw-leading-[43px] tw-text-white" type="button" data-gift-submit>{% if gift_wrap_active == 'Yes' %}Update{% else %}Add{% endif %}</button>
    </div>
  </div>
{%- endif -%}
